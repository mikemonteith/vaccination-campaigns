{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cohort.schema.json",
  "title": "Cohort",
  "description": "A group of patients who may be eligible for a campaign. The entry ID is the file name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description"],
  "properties": {
    "name": {
      "title": "Name",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "title": "Description",
      "description": "The authoritative wording of who is in this cohort.",
      "type": "string",
      "minLength": 1
    },
    "minAgeYears": {
      "title": "Minimum age (years)",
      "type": "integer",
      "minimum": 0
    },
    "maxAgeYears": {
      "title": "Maximum age (years)",
      "type": "integer",
      "minimum": 0
    }
  }
}
