{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "org-type.schema.json",
  "title": "Organisation type",
  "description": "A type of organisation that may take part in a campaign. The entry ID is the file name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {
      "title": "Name",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "title": "Description",
      "type": "string"
    }
  }
}
